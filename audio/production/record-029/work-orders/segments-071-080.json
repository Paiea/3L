    {
      "index": 71,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"It was.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 72,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"You remember which child disliked wrapped hands.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 73,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Mira.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 74,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Which woke when placed down.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 75,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Tomas.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 76,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Which watched fire.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 77,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Mira.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 78,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Which watched you.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 79,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\nI looked at him.\n\n\"Tomas.\"\n\nIthar said nothing.\n\nThat was worse than arguing.\n\n\"Sleep deprivation is bad,\" I said.\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 80,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"I believe you.\"",
      "pause_after_ms": 1100
    }
  ]
}
