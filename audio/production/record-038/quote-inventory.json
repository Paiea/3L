{
  "record": "038",
  "quote_count": 142,
  "quotes": [
    {
      "quote_index": 1,
      "text": "\"Blue opened with distance control.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 149,
      "end": 185
    },
    {
      "quote_index": 2,
      "text": "\"Meaning.\"",
      "occurrence": 1,
      "total_occurrences": 3,
      "start": 187,
      "end": 197
    },
    {
      "quote_index": 3,
      "text": "\"He took center.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 199,
      "end": 216
    },
    {
      "quote_index": 4,
      "text": "\"Meaning.\"",
      "occurrence": 2,
      "total_occurrences": 3,
      "start": 218,
      "end": 228
    },
    {
      "quote_index": 5,
      "text": "\"He stood two feet closer to the west boundary than his opponent.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 230,
      "end": 296
    },
    {
      "quote_index": 6,
      "text": "\"Better.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 298,
      "end": 307
    },
    {
      "quote_index": 7,
      "text": "\"This is going to be annoying, isn't it?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 327,
      "end": 368
    },
    {
      "quote_index": 8,
      "text": "\"Yes.\"",
      "occurrence": 1,
      "total_occurrences": 10,
      "start": 370,
      "end": 376
    },
    {
      "quote_index": 9,
      "text": "\"Again,\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 781,
      "end": 789
    },
    {
      "quote_index": 10,
      "text": "\"Blue's rear foot was wider in the second minute.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 817,
      "end": 867
    },
    {
      "quote_index": 11,
      "text": "\"How much?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 869,
      "end": 880
    },
    {
      "quote_index": 12,
      "text": "\"I don't know.\"",
      "occurrence": 1,
      "total_occurrences": 2,
      "start": 882,
      "end": 897
    },
    {
      "quote_index": 13,
      "text": "\"Then say wider.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 899,
      "end": 916
    },
    {
      "quote_index": 14,
      "text": "\"His left hand opened twice between exchanges.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 918,
      "end": 965
    },
    {
      "quote_index": 15,
      "text": "\"Good.\"",
      "occurrence": 1,
      "total_occurrences": 6,
      "start": 967,
      "end": 974
    },
    {
      "quote_index": 16,
      "text": "\"His support moved closer after the ninth exchange.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 976,
      "end": 1028
    },
    {
      "quote_index": 17,
      "text": "\"How much closer?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1030,
      "end": 1048
    },
    {
      "quote_index": 18,
      "text": "\"One step. Maybe two.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1050,
      "end": 1072
    },
    {
      "quote_index": 19,
      "text": "\"One or two?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1074,
      "end": 1087
    },
    {
      "quote_index": 20,
      "text": "\"One.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1089,
      "end": 1095
    },
    {
      "quote_index": 21,
      "text": "\"You changed that quickly.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1097,
      "end": 1124
    },
    {
      "quote_index": 22,
      "text": "\"Fine. I don't know. Closer.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1126,
      "end": 1155
    },
    {
      "quote_index": 23,
      "text": "\"Good.\"",
      "occurrence": 2,
      "total_occurrences": 6,
      "start": 1157,
      "end": 1164
    },
    {
      "quote_index": 24,
      "text": "\"Blue breathed through his mouth after the long clinch.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1261,
      "end": 1317
    },
    {
      "quote_index": 25,
      "text": "\"Before?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1319,
      "end": 1328
    },
    {
      "quote_index": 26,
      "text": "\"Nose mostly.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1330,
      "end": 1344
    },
    {
      "quote_index": 27,
      "text": "\"Mostly.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1346,
      "end": 1355
    },
    {
      "quote_index": 28,
      "text": "\"I wasn't counting nostrils.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1357,
      "end": 1386
    },
    {
      "quote_index": 29,
      "text": "\"You were counting my chestnuts.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1388,
      "end": 1421
    },
    {
      "quote_index": 30,
      "text": "\"His guard started coming up before his rear foot settled.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1430,
      "end": 1489
    },
    {
      "quote_index": 31,
      "text": "\"That one you said before.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1514,
      "end": 1541
    },
    {
      "quote_index": 32,
      "text": "\"Because it mattered.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1543,
      "end": 1565
    },
    {
      "quote_index": 33,
      "text": "\"You are doing it again.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1567,
      "end": 1592
    },
    {
      "quote_index": 34,
      "text": "\"His guard came up before the rear foot settled,\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1713,
      "end": 1762
    },
    {
      "quote_index": 35,
      "text": "\"Good.\"",
      "occurrence": 3,
      "total_occurrences": 6,
      "start": 1776,
      "end": 1783
    },
    {
      "quote_index": 36,
      "text": "\"That is all?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1785,
      "end": 1799
    },
    {
      "quote_index": 37,
      "text": "\"That is what you saw.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1801,
      "end": 1824
    },
    {
      "quote_index": 38,
      "text": "\"And then I interpret it.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1826,
      "end": 1852
    },
    {
      "quote_index": 39,
      "text": "\"Eventually.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1854,
      "end": 1867
    },
    {
      "quote_index": 40,
      "text": "\"When?\"",
      "occurrence": 1,
      "total_occurrences": 2,
      "start": 1869,
      "end": 1876
    },
    {
      "quote_index": 41,
      "text": "\"After you stop changing the observation to fit the interpretation.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 1878,
      "end": 1946
    },
    {
      "quote_index": 42,
      "text": "\"So what actually happened?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2145,
      "end": 2173
    },
    {
      "quote_index": 43,
      "text": "\"You tell me.\"",
      "occurrence": 1,
      "total_occurrences": 2,
      "start": 2184,
      "end": 2198
    },
    {
      "quote_index": 44,
      "text": "\"Blue accumulated load.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2200,
      "end": 2224
    },
    {
      "quote_index": 45,
      "text": "\"Everyone accumulates load.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2226,
      "end": 2254
    },
    {
      "quote_index": 46,
      "text": "\"His recovery changed.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2256,
      "end": 2279
    },
    {
      "quote_index": 47,
      "text": "\"Yes.\"",
      "occurrence": 2,
      "total_occurrences": 10,
      "start": 2281,
      "end": 2287
    },
    {
      "quote_index": 48,
      "text": "\"His support was compensating.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2289,
      "end": 2320
    },
    {
      "quote_index": 49,
      "text": "\"The support moved closer. Blue started showing readiness before he was actually ready. His breathing changed. His stance widened.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2413,
      "end": 2544
    },
    {
      "quote_index": 50,
      "text": "\"Yes.\"",
      "occurrence": 3,
      "total_occurrences": 10,
      "start": 2546,
      "end": 2552
    },
    {
      "quote_index": 51,
      "text": "\"So the support saw deterioration and spent more to hide it.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2554,
      "end": 2615
    },
    {
      "quote_index": 52,
      "text": "\"Maybe.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2694,
      "end": 2702
    },
    {
      "quote_index": 53,
      "text": "\"You just made me spend ten minutes being precise so you could say maybe.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2715,
      "end": 2789
    },
    {
      "quote_index": 54,
      "text": "\"Precision does not create certainty.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2791,
      "end": 2829
    },
    {
      "quote_index": 55,
      "text": "\"You remember the sentence.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2908,
      "end": 2936
    },
    {
      "quote_index": 56,
      "text": "\"Obviously.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2938,
      "end": 2950
    },
    {
      "quote_index": 57,
      "text": "\"You remember many things Arcrutus said.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2952,
      "end": 2993
    },
    {
      "quote_index": 58,
      "text": "\"He didn't say much.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 2995,
      "end": 3016
    },
    {
      "quote_index": 59,
      "text": "\"That may have helped.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 3018,
      "end": 3041
    },
    {
      "quote_index": 60,
      "text": "\"Are you making a point?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 3138,
      "end": 3163
    },
    {
      "quote_index": 61,
      "text": "\"Not yet.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 3165,
      "end": 3175
    },
    {
      "quote_index": 62,
      "text": "\"Good.\"",
      "occurrence": 4,
      "total_occurrences": 6,
      "start": 3177,
      "end": 3184
    },
    {
      "quote_index": 63,
      "text": "\"Continue.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 3186,
      "end": 3197
    },
    {
      "quote_index": 64,
      "text": "\"Who loses?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7373,
      "end": 7385
    },
    {
      "quote_index": 65,
      "text": "\"Sword.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7424,
      "end": 7432
    },
    {
      "quote_index": 66,
      "text": "\"Why?\"",
      "occurrence": 1,
      "total_occurrences": 2,
      "start": 7434,
      "end": 7440
    },
    {
      "quote_index": 67,
      "text": "\"His support is compensating harder every exchange.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7442,
      "end": 7494
    },
    {
      "quote_index": 68,
      "text": "\"Meaning.\"",
      "occurrence": 3,
      "total_occurrences": 3,
      "start": 7496,
      "end": 7506
    },
    {
      "quote_index": 69,
      "text": "\"He keeps moving closer.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7508,
      "end": 7533
    },
    {
      "quote_index": 70,
      "text": "\"Observation.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7535,
      "end": 7549
    },
    {
      "quote_index": 71,
      "text": "\"His jaw is tight. Thumb into palm. He stopped blinking during the last sustained exchange.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7551,
      "end": 7643
    },
    {
      "quote_index": 72,
      "text": "\"Good.\"",
      "occurrence": 5,
      "total_occurrences": 6,
      "start": 7645,
      "end": 7652
    },
    {
      "quote_index": 73,
      "text": "\"Sword's left heel is wider on landing. His guard is still sharp. His speed looks the same.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7654,
      "end": 7746
    },
    {
      "quote_index": 74,
      "text": "\"Looks.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7748,
      "end": 7756
    },
    {
      "quote_index": 75,
      "text": "\"Yes.\"",
      "occurrence": 4,
      "total_occurrences": 10,
      "start": 7758,
      "end": 7764
    },
    {
      "quote_index": 76,
      "text": "\"So why sword?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 7794,
      "end": 7809
    },
    {
      "quote_index": 77,
      "text": "\"Because he isn't fine,\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 8046,
      "end": 8070
    },
    {
      "quote_index": 78,
      "text": "\"He looks fine because the support is spending more and more to keep him looking fine.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 8104,
      "end": 8191
    },
    {
      "quote_index": 79,
      "text": "\"He isn't holding together,\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 8413,
      "end": 8441
    },
    {
      "quote_index": 80,
      "text": "\"No.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 8496,
      "end": 8501
    },
    {
      "quote_index": 81,
      "text": "\"Someone is holding him together.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 8550,
      "end": 8584
    },
    {
      "quote_index": 82,
      "text": "\"When did he lose?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 9902,
      "end": 9921
    },
    {
      "quote_index": 83,
      "text": "\"Before that.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10060,
      "end": 10074
    },
    {
      "quote_index": 84,
      "text": "\"When?\"",
      "occurrence": 2,
      "total_occurrences": 2,
      "start": 10076,
      "end": 10083
    },
    {
      "quote_index": 85,
      "text": "\"I don't know.\"",
      "occurrence": 2,
      "total_occurrences": 2,
      "start": 10085,
      "end": 10100
    },
    {
      "quote_index": 86,
      "text": "\"Good.\"",
      "occurrence": 6,
      "total_occurrences": 6,
      "start": 10140,
      "end": 10147
    },
    {
      "quote_index": 87,
      "text": "\"Good?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10149,
      "end": 10156
    },
    {
      "quote_index": 88,
      "text": "\"You do not know.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10158,
      "end": 10176
    },
    {
      "quote_index": 89,
      "text": "\"Usually people prefer answers.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10178,
      "end": 10210
    },
    {
      "quote_index": 90,
      "text": "\"People prefer closure.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10212,
      "end": 10236
    },
    {
      "quote_index": 91,
      "text": "\"Different?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10238,
      "end": 10250
    },
    {
      "quote_index": 92,
      "text": "\"Often.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10252,
      "end": 10260
    },
    {
      "quote_index": 93,
      "text": "\"He did his job.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10362,
      "end": 10379
    },
    {
      "quote_index": 94,
      "text": "\"Yes.\"",
      "occurrence": 5,
      "total_occurrences": 10,
      "start": 10381,
      "end": 10387
    },
    {
      "quote_index": 95,
      "text": "\"And they still lost.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10389,
      "end": 10411
    },
    {
      "quote_index": 96,
      "text": "\"Yes.\"",
      "occurrence": 6,
      "total_occurrences": 10,
      "start": 10413,
      "end": 10419
    },
    {
      "quote_index": 97,
      "text": "\"So what was the point?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10421,
      "end": 10445
    },
    {
      "quote_index": 98,
      "text": "\"You tell me.\"",
      "occurrence": 2,
      "total_occurrences": 2,
      "start": 10494,
      "end": 10508
    },
    {
      "quote_index": 99,
      "text": "\"He kept his fighter dangerous longer.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10618,
      "end": 10657
    },
    {
      "quote_index": 100,
      "text": "\"Yes.\"",
      "occurrence": 7,
      "total_occurrences": 10,
      "start": 10659,
      "end": 10665
    },
    {
      "quote_index": 101,
      "text": "\"Maybe long enough to win if one exchange changed.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10667,
      "end": 10718
    },
    {
      "quote_index": 102,
      "text": "\"Yes.\"",
      "occurrence": 8,
      "total_occurrences": 10,
      "start": 10720,
      "end": 10726
    },
    {
      "quote_index": 103,
      "text": "\"He made failure arrive later.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10728,
      "end": 10759
    },
    {
      "quote_index": 104,
      "text": "\"Sometimes that is the job.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 10792,
      "end": 10820
    },
    {
      "quote_index": 105,
      "text": "\"You learned this from Arcrutus.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11223,
      "end": 11256
    },
    {
      "quote_index": 106,
      "text": "\"Some of it.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11258,
      "end": 11271
    },
    {
      "quote_index": 107,
      "text": "\"Did he teach you?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11273,
      "end": 11292
    },
    {
      "quote_index": 108,
      "text": "\"He asked questions.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11294,
      "end": 11315
    },
    {
      "quote_index": 109,
      "text": "\"That is teaching.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11317,
      "end": 11336
    },
    {
      "quote_index": 110,
      "text": "\"Do not encourage him retroactively.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11338,
      "end": 11375
    },
    {
      "quote_index": 111,
      "text": "\"He is dead.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11377,
      "end": 11390
    },
    {
      "quote_index": 112,
      "text": "\"Probably.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11417,
      "end": 11428
    },
    {
      "quote_index": 113,
      "text": "\"You do not know?\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11453,
      "end": 11471
    },
    {
      "quote_index": 114,
      "text": "\"Different life. Different history. He was old when I was young. I have not exactly checked the current census of ancient violent clan heads.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11473,
      "end": 11615
    },
    {
      "quote_index": 115,
      "text": "\"You remember him fondly.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11617,
      "end": 11643
    },
    {
      "quote_index": 116,
      "text": "\"That sounds excessive.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11685,
      "end": 11709
    },
    {
      "quote_index": 117,
      "text": "\"You threw food at him.\"",
      "occurrence": 1,
      "total_occurrences": 1,
      "start": 11711,
      "end": 11735
    },
    {
