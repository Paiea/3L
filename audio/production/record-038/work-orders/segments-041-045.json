      "index": 41,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"He is dead.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 42,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\nI looked at the dragon.\n\n\"Probably.\"\n\nIthar's eye narrowed.\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 43,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"You do not know?\"",
      "pause_after_ms": 1100
    },
    {
      "index": 44,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Different life. Different history. He was old when I was young. I have not exactly checked the current census of ancient violent clan heads.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 45,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"You remember him fondly.\"",
      "pause_after_ms": 1100
    }
  ]
}
