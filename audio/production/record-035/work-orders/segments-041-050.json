  "segments": [
    {
      "index": 41,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"His argument was coherent.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 42,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Do not encourage him retroactively.\"\n\nThe mouth moved again.\n\nAlmost a smile.\n\nThen nothing.\n\nI felt the shape of the trap before he closed it.\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 43,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Your memory functions.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 44,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Apparently.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 45,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Your language functions.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 46,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Less apparently.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 47,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"You just described a ribbon's migration through three household objects and a child's theory of property seizure.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 48,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\n\"Important history.\"\n\n",
      "pause_after_ms": 1100
    },
    {
      "index": 49,
      "speaker": "ithar",
      "voice_id": "normal",
      "transcript": "\"Mm.\"",
      "pause_after_ms": 1100
    },
    {
      "index": 50,
      "speaker": "greg",
      "voice_id": "deep",
      "transcript": "\n\nThere it was again.\n\nI shifted on the stone.\n\nMy left leg had begun hurting two positions ago.\n\nI changed positions.\n\nIt hurt differently.\n\nProgress.\n\nIthar's gaze followed the movement.\n\n\"Do not start on the leg.\"\n\n",
      "pause_after_ms": 1100
    }
  ]
}
